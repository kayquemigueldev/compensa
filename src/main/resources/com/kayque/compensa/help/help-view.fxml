<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      spacing="22.0"
      maxWidth="Infinity"
      styleClass="help-root">

    <padding>
        <Insets top="36.0"
                right="38.0"
                bottom="40.0"
                left="38.0"/>
    </padding>

    <VBox spacing="7.0">
        <Label text="Central de ajuda"
               styleClass="page-title"/>

        <Label text="Encontre respostas rápidas e entenda melhor como aproveitar o Compensa?."
               wrapText="true"
               styleClass="page-subtitle"/>
    </VBox>

    <HBox spacing="16.0"
          alignment="CENTER_LEFT"
          styleClass="help-introduction-card">

        <Label text="?"
               styleClass="help-symbol"/>

        <VBox spacing="5.0">
            <Label text="Como podemos ajudar?"
                   styleClass="help-introduction-title"/>

            <Label text="O Compensa? transforma valores financeiros e suas respostas em informações para apoiar decisões mais conscientes."
                   wrapText="true"
                   styleClass="help-text"/>
        </VBox>
    </HBox>

    <VBox spacing="14.0">
        <Label text="Primeiros passos"
               styleClass="help-section-title"/>

        <HBox spacing="14.0">

            <VBox spacing="9.0"
                  maxWidth="Infinity"
                  HBox.hgrow="ALWAYS"
                  styleClass="help-topic-card">

                <Label text="1"
                       styleClass="help-step-number"/>

                <Label text="Configure seu perfil"
                       wrapText="true"
                       styleClass="help-topic-title"/>

                <Label text="Informe seu nome, objetivo principal e o tom que prefere receber nas recomendações."
                       wrapText="true"
                       styleClass="help-text"/>
            </VBox>

            <VBox spacing="9.0"
                  maxWidth="Infinity"
                  HBox.hgrow="ALWAYS"
                  styleClass="help-topic-card">

                <Label text="2"
                       styleClass="help-step-number"/>

                <Label text="Defina sua realidade financeira"
                       wrapText="true"
                       styleClass="help-topic-title"/>

                <Label text="Cadastre renda, horas trabalhadas, despesas essenciais e a meta mensal de economia."
                       wrapText="true"
                       styleClass="help-text"/>
            </VBox>

            <VBox spacing="9.0"
                  maxWidth="Infinity"
                  HBox.hgrow="ALWAYS"
                  styleClass="help-topic-card">

                <Label text="3"
                       styleClass="help-step-number"/>

                <Label text="Analise suas escolhas"
                       wrapText="true"
                       styleClass="help-topic-title"/>

                <Label text="Informe uma possível compra para descobrir seu custo em dinheiro, tempo e impacto no orçamento."
                       wrapText="true"
                       styleClass="help-text"/>
            </VBox>
        </HBox>
    </VBox>

    <VBox spacing="13.0">
        <Label text="Dúvidas frequentes"
               styleClass="help-section-title"/>

        <TitledPane text="Como o tempo de trabalho é calculado?"
                    expanded="false"
                    animated="true"
                    styleClass="help-faq-item">

            <content>
                <Label text="O Compensa? divide sua renda mensal pelas horas profissionais e pelo tempo adicional informado. Assim, uma compra também pode ser apresentada como tempo real de trabalho."
                       wrapText="true"
                       styleClass="help-faq-answer"/>
            </content>
        </TitledPane>

        <TitledPane text="Meus dados são enviados para algum serviço?"
                    expanded="false"
                    animated="true"
                    styleClass="help-faq-item">

            <content>
                <Label text="Não. Nesta versão, o perfil, as análises, os objetivos e o histórico permanecem armazenados localmente no seu computador."
                       wrapText="true"
                       styleClass="help-faq-answer"/>
            </content>
        </TitledPane>

        <TitledPane text="A recomendação decide se devo comprar?"
                    expanded="false"
                    animated="true"
                    styleClass="help-faq-item">

            <content>
                <Label text="Não. O resultado apresenta pontos positivos e sinais de atenção. A decisão continua sendo sua."
                       wrapText="true"
                       styleClass="help-faq-answer"/>
            </content>
        </TitledPane>

        <TitledPane text="O que são os pontos em Analisar compra?"
                    expanded="false"
                    animated="true"
                    styleClass="help-faq-item">

            <content>
                <VBox spacing="15.0"
                      styleClass="help-score-content">

                    <Label text="Como o Score Compensa? funciona"
                           styleClass="help-score-title"/>

                    <Label text="Toda análise começa com 60 pontos. As informações fornecidas sobre a compra podem aumentar ou diminuir essa pontuação. No final, o resultado é limitado entre 0 e 100 pontos."
                           wrapText="true"
                           styleClass="help-faq-answer"/>

                    <Label text="Contexto da decisão"
                           styleClass="help-score-subtitle"/>

                    <Label text="• Compra planejada: +10 pontos&#10;• Compra não planejada: −10 pontos&#10;• Compra motivada por necessidade: +15 pontos&#10;• Compra motivada por impulso: −20 pontos&#10;• Compra motivada por desejo: não altera o score&#10;• Compra urgente: +5 pontos&#10;• Compra sem alternativa disponível: +5 pontos&#10;• Compra com alternativa disponível: −10 pontos"
                           wrapText="true"
                           styleClass="help-faq-answer"/>

                    <Label text="Impacto no orçamento mensal"
                           styleClass="help-score-subtitle"/>

                    <Label text="• Até 10% do dinheiro disponível: +10 pontos&#10;• Acima de 10% e até 25%: +5 pontos&#10;• Acima de 25% e até 50%: −10 pontos&#10;• Acima de 50%: −25 pontos"
                           wrapText="true"
                           styleClass="help-faq-answer"/>

                    <Label text="Tempo necessário para pagar a compra"
                           styleClass="help-score-subtitle"/>

                    <Label text="• Menos de 1 hora de trabalho: +5 pontos&#10;• Entre 1 hora e menos de 4 horas: não altera o score&#10;• A partir de 4 horas: −10 pontos&#10;• A partir de 8 horas: −20 pontos&#10;• Duas horas ou mais de tempo adicional comprometido: −5 pontos"
                           wrapText="true"
                           styleClass="help-faq-answer"/>

                    <Label text="Impacto no seu objetivo financeiro"
                           styleClass="help-score-subtitle"/>

                    <Label text="• Até 2% do valor do objetivo: +5 pontos&#10;• A partir de 10% do objetivo: −10 pontos&#10;• A partir de 25% do objetivo: −20 pontos&#10;• Quando não existe objetivo com valor definido, esse critério não altera o score"
                           wrapText="true"
                           styleClass="help-faq-answer"/>

                    <Label text="Frequência e projeção anual"
                           styleClass="help-score-subtitle"/>

                    <Label text="• Compra realizada apenas uma vez: não altera o score&#10;• Compra mensal: −5 pontos&#10;• Compra semanal: −12 pontos&#10;• Compra diária: −20 pontos&#10;• Projeção anual a partir de 10% da renda anual: −10 pontos&#10;• Projeção anual a partir de 25% da renda anual: −20 pontos"
                           wrapText="true"
                           styleClass="help-faq-answer"/>

                    <Label text="Como interpretar o resultado"
                           styleClass="help-score-subtitle"/>

                    <VBox spacing="7.0"
                          styleClass="help-score-classifications">

                        <Label text="85 a 100 pontos — Excelente decisão"
                               styleClass="help-score-positive"/>

                        <Label text="70 a 84 pontos — Boa decisão"
                               styleClass="help-score-positive"/>

                        <Label text="50 a 69 pontos — Decisão moderada"
                               styleClass="help-score-moderate"/>

                        <Label text="30 a 49 pontos — Decisão arriscada"
                               styleClass="help-score-risky"/>

                        <Label text="0 a 29 pontos — Decisão crítica"
                               styleClass="help-score-critical"/>
                    </VBox>

                    <Label text="O score não toma a decisão por você. Ele organiza as informações da análise para mostrar fatores favoráveis e pontos que merecem reflexão."
                           wrapText="true"
                           styleClass="help-score-note"/>
                </VBox>
            </content>
        </TitledPane>

        <TitledPane text="Posso desfazer uma contribuição do objetivo?"
                    expanded="false"
                    animated="true"
                    styleClass="help-faq-item">

            <content>
                <Label text="Sim. Na tela Meu objetivo, utilize o botão Desfazer ao lado da contribuição registrada. O progresso será recalculado automaticamente."
                       wrapText="true"
                       styleClass="help-faq-answer"/>
            </content>
        </TitledPane>

        <TitledPane text="O que significam os alertas?"
                    expanded="false"
                    animated="true"
                    styleClass="help-faq-item">

            <content>
                <Label text="Os alertas destacam informações que merecem atenção, como decisões aguardando resposta, compras sem avaliação e situações relevantes do orçamento."
                       wrapText="true"
                       styleClass="help-faq-answer"/>
            </content>
        </TitledPane>
    </VBox>

    <VBox spacing="7.0"
          styleClass="help-notice-card">

        <Label text="Importante"
               styleClass="help-notice-title"/>

        <Label text="O Compensa? é uma ferramenta de reflexão e organização pessoal. Ele não substitui aconselhamento financeiro profissional."
               wrapText="true"
               styleClass="help-text"/>
    </VBox>

    <Region prefHeight="4.0"/>

    <Label text="Compensa? • Desenvolvido por Kayque Miguel"
           styleClass="help-footer"/>
</VBox>