<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      spacing="22.0"
      maxWidth="Infinity"
      styleClass="help-root">

    <padding>
        <Insets top="36.0"
                right="38.0"
                bottom="40.0"
                left="38.0"/>
    </padding>

    <VBox spacing="7.0">
        <Label text="Central de ajuda"
               styleClass="page-title"/>

        <Label text="Encontre respostas rápidas e entenda melhor como aproveitar o Compensa?."
               wrapText="true"
               styleClass="page-subtitle"/>
    </VBox>

    <HBox spacing="16.0"
          alignment="CENTER_LEFT"
          styleClass="help-introduction-card">

        <Label text="?"
               styleClass="help-symbol"/>

        <VBox spacing="5.0">
            <Label text="Como podemos ajudar?"
                   styleClass="help-introduction-title"/>

            <Label text="O Compensa? transforma valores financeiros e suas respostas em informações para apoiar decisões mais conscientes."
                   wrapText="true"
                   styleClass="help-text"/>
        </VBox>
    </HBox>

    <VBox spacing="14.0">
        <Label text="Primeiros passos"
               styleClass="help-section-title"/>

        <HBox spacing="14.0">

            <VBox spacing="9.0"
                  maxWidth="Infinity"
                  HBox.hgrow="ALWAYS"
                  styleClass="help-topic-card">

                <Label text="1"
                       styleClass="help-step-number"/>

                <Label text="Configure seu perfil"
                       wrapText="true"
                       styleClass="help-topic-title"/>

                <Label text="Informe seu nome, objetivo principal e o tom que prefere receber nas recomendações."
                       wrapText="true"
                       styleClass="help-text"/>
            </VBox>

            <VBox spacing="9.0"
                  maxWidth="Infinity"
                  HBox.hgrow="ALWAYS"
                  styleClass="help-topic-card">

                <Label text="2"
                       styleClass="help-step-number"/>

                <Label text="Defina sua realidade financeira"
                       wrapText="true"
                       styleClass="help-topic-title"/>

                <Label text="Cadastre renda, horas trabalhadas, despesas essenciais e a meta mensal de economia."
                       wrapText="true"
                       styleClass="help-text"/>
            </VBox>

            <VBox spacing="9.0"
                  maxWidth="Infinity"
                  HBox.hgrow="ALWAYS"
                  styleClass="help-topic-card">

                <Label text="3"
                       styleClass="help-step-number"/>

                <Label text="Analise suas escolhas"
                       wrapText="true"
                       styleClass="help-topic-title"/>

                <Label text="Informe uma possível compra para descobrir seu custo em dinheiro, tempo e impacto no orçamento."
                       wrapText="true"
                       styleClass="help-text"/>
            </VBox>
        </HBox>
    </VBox>

    <VBox spacing="13.0">
        <Label text="Dúvidas frequentes"
               styleClass="help-section-title"/>

        <TitledPane text="Como o tempo de trabalho é calculado?"
                    expanded="false"
                    animated="true"
                    styleClass="help-faq-item">

            <content>
                <VBox spacing="15.0"
                      styleClass="help-detail-content">

                    <Label text="Transformando dinheiro em tempo"
                           styleClass="help-detail-title"/>

                    <Label text="O Compensa? mostra quanto tempo de trabalho é necessário para pagar uma compra. Para isso, ele utiliza os dados informados no seu Perfil financeiro."
                           wrapText="true"
                           styleClass="help-faq-answer"/>

                    <Label text="Hora profissional"
                           styleClass="help-detail-subtitle"/>

                    <Label text="A renda mensal líquida é dividida pela quantidade de horas profissionais trabalhadas no mês. O resultado representa quanto você recebe por hora de trabalho."
                           wrapText="true"
                           styleClass="help-faq-answer"/>

                    <Label text="Hora real"
                           styleClass="help-detail-subtitle"/>

                    <Label text="O cálculo também considera as horas adicionais comprometidas, como deslocamento e preparação. Com mais tempo envolvido na rotina, o valor real de cada hora pode ficar menor."
                           wrapText="true"
                           styleClass="help-faq-answer"/>

                    <Label text="Tempo necessário para uma compra"
                           styleClass="help-detail-subtitle"/>

                    <Label text="O preço da compra é dividido pelo valor da sua hora. Assim, o aplicativo consegue apresentar o custo em minutos ou horas de trabalho."
                           wrapText="true"
                           styleClass="help-faq-answer"/>

                    <VBox spacing="7.0"
                          styleClass="help-example-card">

                        <Label text="Exemplo"
                               styleClass="help-example-title"/>

                        <Label text="Se sua hora real vale R$ 20,00, uma compra de R$ 100,00 representa aproximadamente 5 horas de trabalho."
                               wrapText="true"
                               styleClass="help-faq-answer"/>
                    </VBox>

                    <Label text="Os valores são estimativas baseadas nas informações cadastradas. Atualize o Perfil financeiro sempre que sua renda ou rotina de trabalho mudar."
                           wrapText="true"
                           styleClass="help-detail-note"/>
                </VBox>
            </content>
        </TitledPane>

        <TitledPane text="O que são os pontos em Analisar compra?"
                    expanded="false"
                    animated="true"
                    styleClass="help-faq-item">

            <content>
                <VBox spacing="15.0"
                      styleClass="help-detail-content">

                    <Label text="Como o Score Compensa? funciona"
                           styleClass="help-detail-title"/>

                    <Label text="Toda análise começa com 60 pontos. As informações fornecidas sobre a compra podem aumentar ou diminuir essa pontuação. No final, o resultado é limitado entre 0 e 100 pontos."
                           wrapText="true"
                           styleClass="help-faq-answer"/>

                    <Label text="Contexto da decisão"
                           styleClass="help-detail-subtitle"/>

                    <Label text="• Compra planejada: +10 pontos&#10;• Compra não planejada: −10 pontos&#10;• Necessidade: +15 pontos&#10;• Impulso: −20 pontos&#10;• Desejo: não altera o score&#10;• Compra urgente: +5 pontos&#10;• Sem alternativa disponível: +5 pontos&#10;• Com alternativa disponível: −10 pontos"
                           wrapText="true"
                           styleClass="help-faq-answer"/>

                    <Label text="Impacto no orçamento mensal"
                           styleClass="help-detail-subtitle"/>

                    <Label text="• Até 10% do dinheiro disponível: +10 pontos&#10;• Acima de 10% e até 25%: +5 pontos&#10;• Acima de 25% e até 50%: −10 pontos&#10;• Acima de 50%: −25 pontos"
                           wrapText="true"
                           styleClass="help-faq-answer"/>

                    <Label text="Tempo necessário"
                           styleClass="help-detail-subtitle"/>

                    <Label text="• Menos de 1 hora: +5 pontos&#10;• Entre 1 hora e menos de 4 horas: não altera o score&#10;• A partir de 4 horas: −10 pontos&#10;• A partir de 8 horas: −20 pontos&#10;• Duas horas ou mais de tempo adicional: −5 pontos"
                           wrapText="true"
                           styleClass="help-faq-answer"/>

                    <Label text="Impacto no objetivo financeiro"
                           styleClass="help-detail-subtitle"/>

                    <Label text="• Até 2% do objetivo: +5 pontos&#10;• A partir de 10% do objetivo: −10 pontos&#10;• A partir de 25% do objetivo: −20 pontos&#10;• Sem objetivo financeiro definido: não altera o score"
                           wrapText="true"
                           styleClass="help-faq-answer"/>

                    <Label text="Frequência e projeção anual"
                           styleClass="help-detail-subtitle"/>

                    <Label text="• Compra única: não altera o score&#10;• Compra mensal: −5 pontos&#10;• Compra semanal: −12 pontos&#10;• Compra diária: −20 pontos&#10;• Projeção anual a partir de 10% da renda anual: −10 pontos&#10;• Projeção anual a partir de 25% da renda anual: −20 pontos"
                           wrapText="true"
                           styleClass="help-faq-answer"/>

                    <Label text="Como interpretar o resultado"
                           styleClass="help-detail-subtitle"/>

                    <VBox spacing="7.0"
                          styleClass="help-score-classifications">

                        <Label text="85 a 100 pontos — Excelente decisão"
                               styleClass="help-score-positive"/>

                        <Label text="70 a 84 pontos — Boa decisão"
                               styleClass="help-score-positive"/>

                        <Label text="50 a 69 pontos — Decisão moderada"
                               styleClass="help-score-moderate"/>

                        <Label text="30 a 49 pontos — Decisão arriscada"
                               styleClass="help-score-risky"/>

                        <Label text="0 a 29 pontos — Decisão crítica"
                               styleClass="help-score-critical"/>
                    </VBox>

                    <Label text="O score organiza os fatores da análise, mas não toma a decisão por você."
                           wrapText="true"
                           styleClass="help-detail-note"/>
                </VBox>
            </content>
        </TitledPane>

        <TitledPane text="A recomendação decide se devo comprar?"
                    expanded="false"
                    animated="true"
                    styleClass="help-faq-item">

            <content>
                <VBox spacing="15.0"
                      styleClass="help-detail-content">

                    <Label text="A decisão continua sendo sua"
                           styleClass="help-detail-title"/>

                    <Label text="O Compensa? não autoriza nem impede nenhuma compra. Ele organiza os dados fornecidos e apresenta uma recomendação para apoiar sua reflexão."
                           wrapText="true"
                           styleClass="help-faq-answer"/>

                    <Label text="O que é considerado?"
                           styleClass="help-detail-subtitle"/>

                    <Label text="• Se a compra foi planejada&#10;• Sua principal motivação&#10;• A existência de alternativas&#10;• A urgência da compra&#10;• O tempo de trabalho necessário&#10;• O impacto no orçamento mensal&#10;• O impacto no seu objetivo financeiro&#10;• A frequência e a projeção anual do gasto"
                           wrapText="true"
                           styleClass="help-faq-answer"/>

                    <Label text="Resultado da análise"
                           styleClass="help-detail-subtitle"/>

                    <Label text="O aplicativo apresenta uma pontuação, uma classificação, fatores positivos e sinais de atenção. Essas informações ajudam você a enxergar consequências que poderiam passar despercebidas."
                           wrapText="true"
                           styleClass="help-faq-answer"/>

                    <Label text="O tom escolhido em Meu perfil altera a forma como a recomendação conversa com você, mas não modifica os fatos financeiros considerados na análise."
                           wrapText="true"
                           styleClass="help-detail-note"/>
                </VBox>
            </content>
        </TitledPane>

        <TitledPane text="Meus dados são enviados para algum serviço?"
                    expanded="false"
                    animated="true"
                    styleClass="help-faq-item">

            <content>
                <VBox spacing="15.0"
                      styleClass="help-detail-content">

                    <Label text="Seus dados permanecem no dispositivo"
                           styleClass="help-detail-title"/>

                    <Label text="Nesta versão, o Compensa? funciona localmente. Os dados cadastrados são armazenados no seu próprio computador."
                           wrapText="true"
                           styleClass="help-faq-answer"/>

                    <Label text="O que fica armazenado?"
                           styleClass="help-detail-subtitle"/>

                    <Label text="• Seu perfil e preferências&#10;• Seu perfil financeiro&#10;• Compras analisadas&#10;• Decisões e avaliações&#10;• Lista de desejos&#10;• Objetivo financeiro e contribuições"
                           wrapText="true"
                           styleClass="help-faq-answer"/>

                    <Label text="Serviços externos"
                           styleClass="help-detail-subtitle"/>

                    <Label text="O aplicativo não envia automaticamente essas informações para serviços externos, contas online ou sistemas de publicidade."
                           wrapText="true"
                           styleClass="help-faq-answer"/>

                    <Label text="Como os dados estão armazenados localmente, eles não são sincronizados automaticamente com outros computadores ou celulares."
                           wrapText="true"
                           styleClass="help-detail-note"/>
                </VBox>
            </content>
        </TitledPane>

        <TitledPane text="Posso desfazer uma contribuição do objetivo?"
                    expanded="false"
                    animated="true"
                    styleClass="help-faq-item">

            <content>
                <VBox spacing="15.0"
                      styleClass="help-detail-content">

                    <Label text="Corrigindo uma contribuição"
                           styleClass="help-detail-title"/>

                    <Label text="Sim. Cada contribuição registrada aparece no histórico da tela Meu objetivo e pode ser desfeita individualmente."
                           wrapText="true"
                           styleClass="help-faq-answer"/>

                    <Label text="Como desfazer"
                           styleClass="help-detail-subtitle"/>

                    <Label text="1. Abra a tela Meu objetivo.&#10;2. Encontre a contribuição em Contribuições recentes.&#10;3. Clique no botão Desfazer.&#10;4. O valor será removido do total guardado."
                           wrapText="true"
                           styleClass="help-faq-answer"/>

                    <Label text="O que acontece depois?"
                           styleClass="help-detail-subtitle"/>

                    <Label text="O progresso, o valor já guardado, o valor restante e a porcentagem do objetivo são recalculados automaticamente."
                           wrapText="true"
                           styleClass="help-faq-answer"/>

                    <Label text="Use essa opção para corrigir valores registrados por engano ou contribuições que precisaram ser retiradas do objetivo."
                           wrapText="true"
                           styleClass="help-detail-note"/>
                </VBox>
            </content>
        </TitledPane>

        <TitledPane text="O que significam os alertas?"
                    expanded="false"
                    animated="true"
                    styleClass="help-faq-item">

            <content>
                <VBox spacing="15.0"
                      styleClass="help-detail-content">

                    <Label text="Informações importantes no momento certo"
                           styleClass="help-detail-title"/>

                    <Label text="Os alertas destacam situações que merecem atenção. Eles são criados a partir dos dados armazenados no aplicativo."
                           wrapText="true"
                           styleClass="help-faq-answer"/>

                    <Label text="Alertas de atenção"
                           styleClass="help-detail-subtitle"/>

                    <Label text="Podem indicar decisões aguardando resposta, compras ainda não avaliadas, aproximação do limite mensal ou ausência de progresso recente no objetivo."
                           wrapText="true"
                           styleClass="help-faq-answer"/>

                    <Label text="Alertas positivos"
                           styleClass="help-detail-subtitle"/>

                    <Label text="Também podem destacar progresso no objetivo, valores preservados e marcos importantes alcançados durante sua jornada."
                           wrapText="true"
                           styleClass="help-faq-answer"/>

                    <Label text="Alertas informativos"
                           styleClass="help-detail-subtitle"/>

                    <Label text="Apresentam lembretes e informações úteis que ajudam a manter o histórico e os resultados do aplicativo atualizados."
                           wrapText="true"
                           styleClass="help-faq-answer"/>

                    <Label text="Um alerta não significa necessariamente que existe um problema. Ele apenas destaca algo que pode merecer sua atenção."
                           wrapText="true"
                           styleClass="help-detail-note"/>
                </VBox>
            </content>
        </TitledPane>
    </VBox>

    <VBox spacing="7.0"
          styleClass="help-notice-card">

        <Label text="Importante"
               styleClass="help-notice-title"/>

        <Label text="O Compensa? é uma ferramenta de reflexão e organização pessoal. Ele não substitui aconselhamento financeiro profissional."
               wrapText="true"
               styleClass="help-text"/>
    </VBox>

    <Region prefHeight="4.0"/>

    <Label text="Compensa? • Desenvolvido por Kayque Miguel"
           styleClass="help-footer"/>
</VBox>